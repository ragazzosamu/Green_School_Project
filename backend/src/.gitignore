# ----------------------------------------------------------------------
# LARAVEL CORE & PACCHETTI
# ----------------------------------------------------------------------
/vendor/
/node_modules/
/public/build/
/public/hot/
/public/storage/
/storage/*.key
/storage/pail/
/auth.json
# NB: NON ignorare tutta /bootstrap/cache/ — cancellerebbe dal repo anche il
# .gitignore interno, e git non riuscirebbe a preservare la cartella vuota.
# I file generati dentro bootstrap/cache/ sono gia' ignorati dal .gitignore
# che sta dentro quella cartella (pattern "*" + "!.gitignore").

# ----------------------------------------------------------------------
# AMBIENTE & CONFIGURAZIONI (Mai committare credenziali!)
# ----------------------------------------------------------------------
.env
.env.backup
.env.production

# ----------------------------------------------------------------------
# DOCKER (Dati persistenti e log)
# ----------------------------------------------------------------------
# Ignora le cartelle locali usate dai volumi Docker (es. database)
# (Se nel tuo docker-compose usi cartelle diverse, aggiungile qui)
/docker/mysql/
/docker/mariadb/
/.docker/
/db_data/

# ----------------------------------------------------------------------
# TEST, CACHE & LOG
# ----------------------------------------------------------------------
*.log
/.phpunit.cache/
.phpunit.result.cache

# ----------------------------------------------------------------------
# IDE & AUTOCOMPLETAMENTO
# ----------------------------------------------------------------------
/.idea/
/.vscode/
/.cursor/
/.nova/
/.zed/
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# ----------------------------------------------------------------------
# VAGRANT / HOMESTEAD (Se utilizzati)
# ----------------------------------------------------------------------
Homestead.json
Homestead.yaml

# ----------------------------------------------------------------------
# FILE DI SISTEMA (MacOS & Windows)
# ----------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
Desktop.ini