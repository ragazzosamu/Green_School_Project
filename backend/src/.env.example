APP_NAME="Green_School project"
APP_ENV=local
APP_KEY=base64:FyW2I45gBH8EE7m4frwGEj2yqm2E5cFZxmEogvLWriA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- CONFIGURAZIONE DATABASE (MARIADB) ---
# Usiamo i nomi dei servizi definiti nel tuo docker-compose
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=db_green_school
DB_USERNAME=admin
DB_PASSWORD=password

# --- CONFIGURAZIONE REDIS ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis

# --- CONFIGURAZIONE REVERB (Il Motore WebSocket) ---
# REVERB_HOST=0.0.0.0 dice al container di ascoltare su tutte le reti interne di Docker
REVERB_APP_ID=green_school
REVERB_APP_KEY=a350d2367d13394c34e998d87a135962
REVERB_APP_SECRET=c39d22e1bd02e4e10b97e58dbefa68e9e8cab25e8a37cfe6d277b28091874078
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# REVERB_SERVER_* sono usati QUANDO Laravel (container 'app') deve spedire
# eventi a Reverb. 'reverb' e' il nome del servizio nel docker-compose.
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
REVERB_SERVER_SCHEME=http

# --- CONFIGURAZIONE VITE (Il Postino per il Browser) ---
# Queste variabili vengono "iniettate" nel JavaScript che l'utente scarica.
# VITE_REVERB_HOST=localhost perché il browser dell'utente "vede" Docker tramite localhost
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- ALTRE IMPOSTAZIONI ---
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- MQTT (Broker Mosquitto) ---
# 'mqtt' è il nome del servizio nel docker-compose, risolto dalla rete bridge.
MQTT_HOST=mqtt
MQTT_PORT=1883

# --- Registrazione IoT ---
# Password globale usata SOLO per la prima chiamata POST /api/iot/registra:
# la colonnina la legge dal proprio .env (PASSWORD_REGISTRAZIONE) e la manda
# al backend una sola volta. Da quel momento riceve un device_token e dialoga
# col broker MQTT senza autenticazione (il broker e' anonimo).
IOT_REGISTRATION_PASSWORD=greenschool-iot-2025
