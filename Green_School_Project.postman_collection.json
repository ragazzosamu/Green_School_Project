    {
      "name": "Realtime (WebSocket auth)",
      "item": [
        {
          "name": "POST /broadcasting/auth (handshake canali privati)",
          "description": "Echo lato React chiama questo endpoint per autorizzare la sottoscrizione a un PrivateChannel (es. user.{id}). Solitamente lo fa Echo da solo: questa request serve solo a debugging.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "socket_id", "value": "12345.67890" },
                { "key": "channel_name", "value": "private-user.{{id_utente}}" }
              ]
            },
            "url": {
              "raw": "{{api}}/broadcasting/auth",
              "host": ["{{api}}"],
              "path": ["broadcasting", "auth"]
            }
          }
        }
      ]
    },
