    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Converti la risposta in un oggetto JSON\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "// 2. Estrai il token (modifica 'access_token' in base a come risponde la tua API)\r",
              "// Esempi comuni: jsonData.token oppure jsonData.data.token\r",
              "const token = jsonData.access_token;\r",
              "\r",
              "// 3. Salva il token in una variabile d'ambiente\r",
              "if (token) {\r",
              "    pm.environment.set(\"token\", token);\r",
              "    console.log(\"Token salvato con successo!\");\r",
              "} else {\r",
              "    console.warn(\"Token non trovato nella risposta!\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
