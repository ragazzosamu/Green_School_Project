              "raw": "{\n  \"mac_address\": \"AA:BB:CC:DD:EE:06\",\n  \"password_globale\": \"PASSWORD_IOT_GLOBALE\",\n  \"prese\": [\n    { \"identificativo_fisico\": \"P1\", \"potenza_max_kw\": 7.4 }\n  ]\n}"
