{
  "info": {
    "_postman_id": "e5256ca0-2c51-46d7-8cdc-da5b01d5bfbf",
    "name": "Green_School_Project",
    "description": "Collection completa delle API GreenSchool. Variabili: {{api}} = base URL (es. http://localhost/api), {{token}} = Bearer Sanctum (impostato automaticamente dal Login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const token = jsonData.access_token;",
                  "if (token) {",
                  "    pm.environment.set(\"token\", token);",
                  "    pm.collectionVariables.set(\"token\", token);",
                  "    console.log(\"Token salvato.\");",
                  "} else {",
                  "    console.warn(\"Token non trovato.\");",
                  "}",
                  "const idUtente = jsonData.user && jsonData.user.id_utente;",
                  "if (idUtente) {",
                  "    pm.environment.set(\"id_utente\", idUtente);",
                  "    pm.collectionVariables.set(\"id_utente\", idUtente);",
                  "    console.log(\"id_utente salvato.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.test@email.it\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{api}}/login", "host": ["{{api}}"], "path": ["login"] }
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mario\",\n  \"cognome\": \"Rossi\",\n  \"email\": \"mario.rossi@scuola.it\",\n  \"cellulare\": \"+39 333 1234567\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": { "raw": "{{api}}/register", "host": ["{{api}}"], "path": ["register"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{api}}/logout", "host": ["{{api}}"], "path": ["logout"] }
          }
        }
      ]
    },
