# Copia questo file in .env e modifica i valori per il tuo ambiente.
#   cp .env.example .env

# ── WebSocket Reverb ────────────────────────────────────────────────────
# DEVE corrispondere a REVERB_APP_KEY in backend/src/.env, altrimenti
# l'handshake con Reverb fallisce e i canali WebSocket non funzionano.
VITE_REVERB_APP_KEY=your_reverb_app_key_here

# Host/porta che il BROWSER usa per raggiungere Reverb.
# In sviluppo si passa dal proxy Vite (vite.config.js) -> Apache -> Reverb,
# quindi punta a localhost:5173 (il dev server Vite stesso).
# In produzione (HTTPS dietro nginx/ngrok) basta lasciare l'host di sito
# e cambiare scheme a https: i WS viaggiano su 443 senza porta esplicita.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=5173
VITE_REVERB_SCHEME=http
