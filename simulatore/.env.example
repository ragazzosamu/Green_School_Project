# --- Identita' della stazione ---
# Il MAC ADDRESS diventa l'id_stazione lato DB.
# In dev usa un MAC fittizio; in prod la stazione legge il proprio MAC reale.
MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# Password globale di registrazione: e' l'UNICA cosa che il simulatore deve
# conoscere all'avvio. Viene mandata SOLO alla prima chiamata
# POST /api/iot/registra; da quel momento il backend restituisce le credenziali
# MQTT che la colonnina usa per tutto il resto della vita. Deve coincidere
# con IOT_REGISTRATION_PASSWORD nel .env del backend.
PASSWORD_REGISTRAZIONE=greenschool-iot-2025

# Numero di prese fisiche della stazione (deciso dall'hardware).
# Lo mandiamo alla registrazione: il backend crea i record con id_punto = 1..N.
NUMERO_PUNTI=2

# Da dentro il container green_simulatore il backend NON e' su localhost
# (localhost dentro un container e' il container stesso). Va usato il nome
# del servizio docker-compose: il service del backend si chiama "app".
# Se per qualche motivo lanci il simulatore fuori da docker (dal tuo host
# Windows) cambia in http://localhost.
BACKEND_URL=http://app

# --- MQTT (broker Mosquitto) ---
# Host/porta del broker. Le credenziali MQTT NON le mettiamo qui: arrivano
# dall'API di registrazione (mqtt.user / mqtt.password). Il broker dev attuale
# accetta connessioni anonime quindi la password sara' vuota.
MQTT_HOST=green_mqtt-broker
MQTT_PORT=1883

# --- Intervalli (secondi) ---
METER_INTERVAL=5       # telemetria
HEARTBEAT_INTERVAL=60  # heartbeat per punto
CODICE_INTERVAL=3060   # ogni quanti secondi viene generato un nuovo codice monouso (TTL Redis: 35s)
